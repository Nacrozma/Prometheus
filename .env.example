# Copy to .env and fill in. Leave unused providers blank. Never commit .env.
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
TAVILY_API_KEY=

# Obsidian mirror (optional). The folder that CONTAINS .obsidian. Prometheus only writes inside <vault>/Prometheus/
PROMETHEUS_OBSIDIAN_VAULT=
# PROMETHEUS_OBSIDIAN_FOLDER=Prometheus
# PROMETHEUS_OBSIDIAN_AUTOSYNC=1   # export once when the CLI exits

# Skills and self-patching (optional)
# PROMETHEUS_SKILL_SANDBOX=auto        # auto | docker | subprocess
# PROMETHEUS_PATCH_GATE=on             # "off" disables the automatic checks on self-patches (not recommended)
# PROMETHEUS_PATCH_GATE_TIMEOUT=240    # seconds allowed for the test suite inside the gate
