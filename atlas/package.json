{
  "name": "atlas-copilot",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "ATLAS Co-Pilot — a local-first AI desktop companion",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "test:rust": "cargo test --workspace",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:rust"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tauri-apps/api": "2.12.4",
    "@xyflow/react": "12.12.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.67.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.4",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "^4.14.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "selenium-webdriver": "^4.52.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
