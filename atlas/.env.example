# DEVELOPMENT TEMPLATE ONLY — never commit real API keys. `.env` files are git-ignored.
#
# The ATLAS Co-Pilot desktop app does NOT read API keys from the environment. In the app, keys
# are entered in Integrations and stored in your operating system's credential store
# (Windows Credential Manager / macOS Keychain / Secret Service). They are never written to
# SQLite, logs, backups, or sent to Prometheus.
#
# These variables are read only by the opt-in live provider check:
#   cargo test -p atlas-core --test live_providers -- --ignored --nocapture
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
# Optional local provider
OLLAMA_BASE_URL=http://localhost:11434
# Optional per-provider model for the live check, e.g. ATLAS_LIVE_OPENAI_MODEL=gpt-4.1-nano
# ATLAS_LIVE_OPENAI_MODEL=

# Use a different data folder (database, settings) for development without touching real data.
# ATLAS_DATA_DIR=/tmp/atlas-dev-data
